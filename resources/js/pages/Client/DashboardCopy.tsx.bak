                backgroundColor: '#FFFFFF',
                borderColor: '#E8DDD5',
                color: COLOR_BURGUNDY,
            }}
className = "px-2.5 py-1 rounded-md border text-[10px] font-bold inline-flex items-center gap-1 hover:bg-slate-50 transition-colors shrink-0 shadow-2xs"
    >
