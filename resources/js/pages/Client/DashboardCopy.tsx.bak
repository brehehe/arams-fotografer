    < a
href = "https://wa.me/6281234567890"
target = "_blank"
rel = "noreferrer"
style = {{
    borderColor: '#E8DDD5',
                                            }}
className = "w-full py-1.5 rounded-lg border bg-slate-50 hover:bg-slate-100 text-[10.5px] font-bold text-slate-700 transition-colors flex items-center justify-center gap-1"
