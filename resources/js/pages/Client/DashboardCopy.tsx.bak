                    <h4
                                    style={ { color: COLOR_BURGUNDY } }
className = "text-xs sm:text-sm font-bold"
    >
    { activeStepObj.title?.replace(/^\d+\.\s*/, '') || activeStepObj.name || 'Preview Foto' }
    </h4>
    < p className = "text-xs text-slate-600 leading-relaxed max-w-2xl" >
        { activeStepObj.desc || activeStepObj.description || 'Kami sedang menyiapkan preview foto terbaik untuk Anda. Nantikan update selanjutnya!' }
        </p>
        </div>
        </div>

        < Link
href = { active_project?.id? `/client/projects/${active_project.id}#timeline` : '/client/projects'}
style = {{
    backgroundColor: '#FFFFFF',
        color: COLOR_BURGUNDY,
            borderColor: '#E8DDD5',
                            }}
className = "inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border text-xs font-bold shadow-2xs hover:bg-slate-50 transition-colors shrink-0"
    >
    <span>Lihat Detail </span>
        < ArrowRight className = "w-3.5 h-3.5" />
            </Link>
            </div>
            </section>

{/* ── 3. THREE-COLUMN ROW (FILE TERBARU, PEMBAYARAN, HIGHLIGHT) ── */ }
<section className="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 items-stretch" >
