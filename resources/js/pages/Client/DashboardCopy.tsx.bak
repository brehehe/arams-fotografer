        color: COLOR_BURGUNDY,
            borderColor: '#E8DDD5',
                                }}
className = "w-full py-2.5 rounded-lg border text-xs font-bold text-center inline-flex items-center justify-center gap-2 hover:bg-slate-50 transition-colors shadow-2xs"
